generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model SiteSettings {
  id              String   @id @default("default")
  profileImageUrl String?
  profileImageKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ArchivePost {
  id          String         @id @default(cuid())
  description String
  takenAt     DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ArchiveImage[]

  @@index([createdAt])
  @@index([takenAt])
}

model ArchiveImage {
  id        String      @id @default(cuid())
  postId    String
  key       String
  url       String
  order     Int
  createdAt DateTime    @default(now())
  post      ArchivePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, order])
}
