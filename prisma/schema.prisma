generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        String            @id @default(cuid())
  content   String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  comments  PoemarioComment[]

  @@index([createdAt])
}

model PoemarioComment {
  id        String             @id @default(cuid())
  postId    String
  parentId  String?
  text      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  post      Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    PoemarioComment?   @relation("PoemarioCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PoemarioComment[]  @relation("PoemarioCommentReplies")

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
}

model SiteSettings {
  id              String   @id @default("default")
  profileImageUrl String?
  profileImageKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ArchivePost {
  id          String         @id @default(cuid())
  description String
  takenAt     DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ArchiveImage[]

  @@index([createdAt])
  @@index([takenAt])
}

model ArchiveImage {
  id        String      @id @default(cuid())
  postId    String
  key       String
  url       String
  order     Int
  createdAt DateTime    @default(now())
  post      ArchivePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, order])
}
