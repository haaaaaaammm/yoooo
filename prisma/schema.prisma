generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        String            @id @default(cuid())
  content   String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  comments  PoemarioComment[]

  @@index([createdAt])
}

model PoemarioComment {
  id        String             @id @default(cuid())
  postId    String
  parentId  String?
  text      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  post      Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    PoemarioComment?   @relation("PoemarioCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PoemarioComment[]  @relation("PoemarioCommentReplies")

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
}

model SiteSettings {
  id              String   @id @default("default")
  profileImageUrl String?
  profileImageKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ArchivePost {
  id           String         @id @default(cuid())
  kind         String         @default("post")
  title        String?
  description  String
  takenAt      DateTime       @default(now())
  coverImageId String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  coverImage   ArchiveImage?  @relation("ArchivePostCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  images       ArchiveImage[] @relation("ArchivePostImages")

  @@index([createdAt])
  @@index([kind, takenAt])
  @@index([takenAt])
}

model ArchiveImage {
  id        String      @id @default(cuid())
  postId    String
  key       String
  url       String
  order     Int
  createdAt DateTime    @default(now())
  coverFor  ArchivePost? @relation("ArchivePostCoverImage")
  post      ArchivePost @relation("ArchivePostImages", fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, order])
}
